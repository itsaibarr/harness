#!/usr/bin/env bash
# route-task launcher: PYTHONPATH points at this directory so `python3 -m route_task` resolves without install.
# Resolves symlinks so it works when linked into ~/.local/bin.
SRC="${BASH_SOURCE[0]}"
while [ -h "$SRC" ]; do
  D="$(cd "$(dirname "$SRC")" && pwd)"
  SRC="$(readlink "$SRC")"
  [[ "$SRC" != /* ]] && SRC="$D/$SRC"
done
DIR="$(cd "$(dirname "$SRC")" && pwd)"
PYTHONPATH="$DIR" exec python3 -m route_task "$@"
