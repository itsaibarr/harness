#!/usr/bin/env python3
"""Fake `claude -p … --output-format stream-json --verbose`.
STUB_CL: ok | error | hang.  STUB_5H / STUB_7D: utilization to report.  STUB_STRUCT: JSON string returned as structured_output.
STUB_WRITE: file to create in cwd (simulates premium editing).  Logs argv/env/cwd to STUB_LOG."""
import json, os, sys, time

log = os.environ.get("STUB_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps({"tool": "claude", "argv": sys.argv[1:], "env": dict(os.environ), "cwd": os.getcwd()}) + "\n")

mode = os.environ.get("STUB_CL", "ok")
sid = "claude-sess-1"

def emit(o):
    print(json.dumps(o), flush=True)

emit({"type": "system", "subtype": "init", "session_id": sid})
emit({"type": "rate_limit_event", "rate_limit_info": {"status": "allowed", "unifiedWindows": {
    "five_hour": {"utilization": float(os.environ.get("STUB_5H", "0.1")), "resetsAt": 2000000000},
    "seven_day": {"utilization": float(os.environ.get("STUB_7D", "0.1")), "resetsAt": 2000600000}}}})
if mode == "hang":
    time.sleep(120)
if os.environ.get("STUB_WRITE"):
    open(os.path.join(os.getcwd(), os.environ["STUB_WRITE"]), "w").write("premium output\n")
if mode == "error":
    emit({"type": "result", "subtype": "error_during_execution", "is_error": True, "result": "api error",
          "session_id": sid, "total_cost_usd": 0.0, "permission_denials": []})
    sys.exit(1)
res = {"type": "result", "subtype": "success", "is_error": False, "result": os.environ.get("STUB_TEXT", "done"),
       "session_id": sid, "total_cost_usd": 0.01, "permission_denials": []}
if os.environ.get("STUB_STRUCT"):
    res["structured_output"] = json.loads(os.environ["STUB_STRUCT"])
emit(res)
